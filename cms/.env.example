# Переменные окружения CMS. Vite встраивает их в бандл при сборке,
# поэтому в браузер попадают только переменные с префиксом VITE_.
# Значения проверяются zod-схемой в src/shared/config/env.ts:
# при неверном значении CMS не запустится и покажет, какое поле исправить.

# Базовый URL бэкенда без /api и без завершающего слеша.
# Прод: https://api.zhbl.by
# Локально: http://localhost:5001
VITE_API_URL=https://api.zhbl.by

# Адрес публичного сайта. Из него собираются ссылки «Открыть на сайте»
# для товаров (/menu/<категория>/<товар>) и новостей (/news/<url>).
# Прод: https://zhbl.by
# Локально: http://localhost:3000
VITE_SITE_URL=https://zhbl.by
