    "@tiptap/starter-kit": "^3.32.0",
    "axios": "^1.20.0",
    "effector": "^23.4.4",
    "effector-react": "^23.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
